# myapp Nushell completion

def "_myapp_no_args" [] {
    []
}

extern "myapp" [
    --verbose  # Verbose
    ...rest: string@"_myapp_no_args"
]

# Manage authentication
extern "myapp auth" [
    --token: string  # Auth token
    ...rest: string@"_myapp_no_args"
]

# Log in
extern "myapp auth login" [
    --browser  # Open browser
    ...rest: string@"_myapp_no_args"
]

# Log out
extern "myapp auth logout" [
    ...rest: string@"_myapp_no_args"
]

# Run command
extern "myapp run" [
    ...rest: string@"_myapp_no_args"
]
