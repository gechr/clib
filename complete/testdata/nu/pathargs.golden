# myapp Nushell completion

def "_myapp_no_args" [] {
    []
}

extern "myapp" [
    --verbose(-v)  # Verbose output
    ...rest: string@"_myapp_no_args"
]

# Edit files
extern "myapp edit" [
    --editor: string  # Editor command
    ...rest: path
]

# List items
extern "myapp list" [
    ...rest: string@"_myapp_no_args"
]
