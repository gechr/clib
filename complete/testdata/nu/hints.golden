# myapp Nushell completion

def "_myapp_no_args" [] {
    []
}

extern "myapp" [
    --config(-c): path  # Config file
    --dir(-d): directory  # Directory
    --host: string  # Host name
    --output(-o): path  # Output path
    --shell: string  # Shell command
    --user: string  # User name
    --verbose(-v)  # Verbose output
    ...rest: string@"_myapp_no_args"
]
