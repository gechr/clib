_pdc() {
    if [[ -z ${COMP_LINE+x} ]]; then
        _pdc_complete "$@"
        return
    fi
    local remaining="$COMP_LINE" fragment index joined=0 consumed suffix
    local -a words=()
    for ((index=0; index<=COMP_CWORD; index++)); do
        fragment=${COMP_WORDS[index]}
        if (( index > 0 )) && [[ $remaining == [[:space:]]* ]]; then
            joined=$((joined + 1))
        fi
        words[joined]=${words[joined]-}$fragment
        remaining=${remaining#*"$fragment"}
        # Some Bash versions omit the surrounding quotes from COMP_WORDS.
        remaining=${remaining#[\'\"]}
    done
    # Ignore text after the cursor, including the rest of the current word.
    consumed=$((${#COMP_LINE} - ${#remaining}))
    suffix=$((consumed - ${COMP_POINT:-$consumed}))
    if (( suffix > 0 && suffix <= ${#words[joined]} )); then
        words[joined]=${words[joined]:0:${#words[joined]}-suffix}
    fi
    local current=${words[joined]} keep="" previous=""
    if [[ -z $2 ]]; then
        keep=$current
    elif [[ $current == *"$2" ]]; then
        keep=${current%"$2"}
    fi
    if (( joined > 0 )); then
        previous=${words[joined-1]}
    fi
    # Dynamic scope gives the helpers reconstructed words without changing
    # the caller's completion state or the shell's word-break settings.
    local -a COMP_WORDS=("${words[@]}")
    local COMP_CWORD=$joined
    _pdc_complete "$1" "$current" "$previous"
    local candidate
    local -a replies=()
    for candidate in "${COMPREPLY[@]}"; do
        if [[ -n $keep && $candidate == "$keep"* ]]; then
            candidate=${candidate#"$keep"}
        fi
        if [[ -n $candidate ]]; then
            replies+=("$candidate")
        fi
    done
    COMPREPLY=("${replies[@]}")
}

# pdc bash completion
_pdc_complete() {
    local i cur opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"; do
        case "${cmd},${i}" in
            ",$1")
                cmd="pdc"
                ;;
            pdc,incident)
                cmd="pdc__incident"
                ;;
            pdc__incident,show)
                cmd="pdc__incident__show"
                ;;
            pdc,user)
                cmd="pdc__user"
                ;;
            pdc__user,show)
                cmd="pdc__user__show"
                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        pdc)
            opts="incident user"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
            return 0
            ;;
        pdc__incident)
            opts="show"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
            return 0
            ;;
        pdc__incident__show)
            opts=""
            if [[ ${cur} == -* ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            local -a __dyn_pos=()
            local __skip_next=0
            local __after_dd=0
            local __cmd_skip=2
            for ((j=1; j<COMP_CWORD; j++)); do
                if [[ "${__after_dd}" -eq 1 ]]; then
                    __dyn_pos+=("${COMP_WORDS[j]}")
                    continue
                fi
                if [[ "${__skip_next}" -eq 1 ]]; then
                    __skip_next=0
                    continue
                fi
                if [[ "${COMP_WORDS[j]}" == "--" ]]; then
                    __after_dd=1
                    continue
                fi
                case "${COMP_WORDS[j]}" in
                    -*)
                        ;;
                    *)
                        if [[ $__cmd_skip -gt 0 ]]; then
                            ((__cmd_skip--))
                        else
                            __dyn_pos+=("${COMP_WORDS[j]}")
                        fi
                        ;;
                esac
            done
            case ${#__dyn_pos[@]} in
                0)
                    COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                    _pdc_dynamic_values "${cur}" pdc --@complete=incident
                    ;;
                *)
                    COMPREPLY=()
                    _pdc_dynamic_values "${cur}" pdc --@complete=incident -- "${__dyn_pos[@]}"
                    ;;
            esac
            return 0
            ;;
        pdc__user)
            opts="show"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
            return 0
            ;;
        pdc__user__show)
            opts=""
            if [[ ${cur} == -* ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            local -a __dyn_pos=()
            local __skip_next=0
            local __after_dd=0
            local __cmd_skip=2
            for ((j=1; j<COMP_CWORD; j++)); do
                if [[ "${__after_dd}" -eq 1 ]]; then
                    __dyn_pos+=("${COMP_WORDS[j]}")
                    continue
                fi
                if [[ "${__skip_next}" -eq 1 ]]; then
                    __skip_next=0
                    continue
                fi
                if [[ "${COMP_WORDS[j]}" == "--" ]]; then
                    __after_dd=1
                    continue
                fi
                case "${COMP_WORDS[j]}" in
                    -*)
                        ;;
                    *)
                        if [[ $__cmd_skip -gt 0 ]]; then
                            ((__cmd_skip--))
                        else
                            __dyn_pos+=("${COMP_WORDS[j]}")
                        fi
                        ;;
                esac
            done
            case ${#__dyn_pos[@]} in
                0)
                    COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                    _pdc_dynamic_values "${cur}" pdc --@complete=user
                    ;;
                *)
                    COMPREPLY=()
                    _pdc_dynamic_values "${cur}" pdc --@complete=user -- "${__dyn_pos[@]}"
                    ;;
            esac
            return 0
            ;;
    esac
}

_pdc_dynamic_values() {
    local cur="$1"
    shift
    local line
    local -a vals=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        vals+=("${line}")
    done < <("$@" 2>/dev/null)
    local IFS=$'\n'
    COMPREPLY+=($(compgen -W "${vals[*]}" -- "${cur}"))
}

if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -F _pdc -o nosort -o bashdefault -o default pdc
else
    complete -F _pdc -o bashdefault -o default pdc
fi
