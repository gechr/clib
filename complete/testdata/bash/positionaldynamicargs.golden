_acme_plugin() {
    if [[ -z ${COMP_LINE+x} ]]; then
        _acme_plugin_complete "$@"
        return
    fi
    local remaining="$COMP_LINE" fragment index joined=0 consumed suffix
    local -a words=()
    for ((index=0; index<=COMP_CWORD; index++)); do
        fragment=${COMP_WORDS[index]}
        if (( index > 0 )) && [[ $remaining == [[:space:]]* ]]; then
            joined=$((joined + 1))
        fi
        words[joined]=${words[joined]-}$fragment
        remaining=${remaining#*"$fragment"}
        # Some Bash versions omit the surrounding quotes from COMP_WORDS.
        remaining=${remaining#[\'\"]}
    done
    # Ignore text after the cursor, including the rest of the current word.
    consumed=$((${#COMP_LINE} - ${#remaining}))
    suffix=$((consumed - ${COMP_POINT:-$consumed}))
    if (( suffix > 0 && suffix <= ${#words[joined]} )); then
        words[joined]=${words[joined]:0:${#words[joined]}-suffix}
    fi
    local current=${words[joined]} keep="" previous=""
    if [[ -z $2 ]]; then
        keep=$current
    elif [[ $current == *"$2" ]]; then
        keep=${current%"$2"}
    fi
    if (( joined > 0 )); then
        previous=${words[joined-1]}
    fi
    # Dynamic scope gives the helpers reconstructed words without changing
    # the caller's completion state or the shell's word-break settings.
    local -a COMP_WORDS=("${words[@]}")
    local COMP_CWORD=$joined
    _acme_plugin_complete "$1" "$current" "$previous"
    local candidate
    local -a replies=()
    for candidate in "${COMPREPLY[@]}"; do
        if [[ -n $keep && $candidate == "$keep"* ]]; then
            candidate=${candidate#"$keep"}
        fi
        if [[ -n $candidate ]]; then
            replies+=("$candidate")
        fi
    done
    COMPREPLY=("${replies[@]}")
}

# acme-plugin bash completion
_acme_plugin_complete() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"; do
        case "${cmd},${i}" in
            ",$1")
                cmd="acme__plugin"
                ;;
            acme__plugin,complete)
                cmd="acme__plugin__complete"
                ;;
            acme__plugin,resolve)
                cmd="acme__plugin__resolve"
                ;;
            acme__plugin,send)
                cmd="acme__plugin__send"
                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        acme__plugin)
            opts="--verbose -v complete resolve send"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
            return 0
            ;;
        acme__plugin__complete)
            opts=""
            if [[ ${cur} == -* ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            local -a __dyn_pos=()
            local __skip_next=0
            local __after_dd=0
            local __cmd_skip=1
            for ((j=1; j<COMP_CWORD; j++)); do
                if [[ "${__after_dd}" -eq 1 ]]; then
                    __dyn_pos+=("${COMP_WORDS[j]}")
                    continue
                fi
                if [[ "${__skip_next}" -eq 1 ]]; then
                    __skip_next=0
                    continue
                fi
                if [[ "${COMP_WORDS[j]}" == "--" ]]; then
                    __after_dd=1
                    continue
                fi
                case "${COMP_WORDS[j]}" in
                    -*)
                        ;;
                    *)
                        if [[ $__cmd_skip -gt 0 ]]; then
                            ((__cmd_skip--))
                        else
                            __dyn_pos+=("${COMP_WORDS[j]}")
                        fi
                        ;;
                esac
            done
            if [[ ${#__dyn_pos[@]} -ge 1 ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            case ${#__dyn_pos[@]} in
                0)
                    COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                    _acme_plugin_dynamic_values "${cur}" acme-plugin --@complete=complete-kind
                    ;;
                *)
                    COMPREPLY=()
                    _acme_plugin_dynamic_values "${cur}" acme-plugin --@complete=complete-kind -- "${__dyn_pos[@]}"
                    ;;
            esac
            return 0
            ;;
        acme__plugin__resolve)
            opts=""
            if [[ ${cur} == -* ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            local -a __dyn_pos=()
            local __skip_next=0
            local __after_dd=0
            local __cmd_skip=1
            for ((j=1; j<COMP_CWORD; j++)); do
                if [[ "${__after_dd}" -eq 1 ]]; then
                    __dyn_pos+=("${COMP_WORDS[j]}")
                    continue
                fi
                if [[ "${__skip_next}" -eq 1 ]]; then
                    __skip_next=0
                    continue
                fi
                if [[ "${COMP_WORDS[j]}" == "--" ]]; then
                    __after_dd=1
                    continue
                fi
                case "${COMP_WORDS[j]}" in
                    -*)
                        ;;
                    *)
                        if [[ $__cmd_skip -gt 0 ]]; then
                            ((__cmd_skip--))
                        else
                            __dyn_pos+=("${COMP_WORDS[j]}")
                        fi
                        ;;
                esac
            done
            if [[ ${#__dyn_pos[@]} -ge 2 ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            case ${#__dyn_pos[@]} in
                0)
                    COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                    _acme_plugin_dynamic_values "${cur}" acme-plugin --@complete=resolve-kind
                    ;;
                *)
                    COMPREPLY=()
                    _acme_plugin_dynamic_values "${cur}" acme-plugin --@complete=resolve-kind -- "${__dyn_pos[@]}"
                    ;;
            esac
            return 0
            ;;
        acme__plugin__send)
            opts="--to"
            local value_prefix=""
            case "${cur}" in
                --to=*)
                    prev=${cur%%=*}
                    value_prefix="${prev}="
                    cur=${cur#*=}
                    ;;
            esac
            case "${prev}" in
                --to)
                    COMPREPLY=()
                    if [[ -n $value_prefix ]]; then
                        COMPREPLY=("${COMPREPLY[@]/#/${value_prefix}}")
                    fi
                    return 0
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]]; then
                COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
                return 0
            fi
            COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
            return 0
            ;;
    esac
}

_acme_plugin_dynamic_values() {
    local cur="$1"
    shift
    local line
    local -a vals=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        vals+=("${line}")
    done < <("$@" 2>/dev/null)
    local IFS=$'\n'
    COMPREPLY+=($(compgen -W "${vals[*]}" -- "${cur}"))
}

if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -F _acme_plugin -o nosort -o bashdefault -o default acme-plugin
else
    complete -F _acme_plugin -o bashdefault -o default acme-plugin
fi
